#!/bin/sh
# No Erlang distribution: nothing connects to this node, so no epmd and no open port for it.
export RELEASE_DISTRIBUTION=none
# The runtime sizes its port and file descriptor tables from the open-files limit, which some
# container runtimes leave near 2^30 (containerd, Kubernetes): gigabytes before the first
# request, and an OOM kill under a memory limit. 65536 ports is far more than testor uses.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"
